{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@plone/volto/*": [
        "../../core/packages/volto/src/*"
      ],
      "@plonegovbr/volto-code-block/*": [
        "./src/*"
      ],
      "@loadable/component": [
        "../../core/packages/volto/node_modules/@types/loadable__component"
